generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTATION_SENT
  NEGOTIATION
  CONVERTED
  LOST
}

enum EventStatus {
  TENTATIVE
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  INCOME
  EXPENSE
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum TimeSlot {
  MORNING
  EVENING
  FULL_DAY
}

enum CommunicationType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  IN_PERSON @map("IN-PERSON")
}

enum InventoryType {
  PURCHASED
  OWNED
  RENTAL
}

enum InventoryStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum InventoryOrderStatus {
  PLACED
  DELIVERED
  CANCELLED
}

enum DirectoryContactType {
  EMPLOYEE
  OTHER
}

enum InventoryTransactionType {
  PURCHASE
  RENT
  RETURN
  DAMAGE
}

enum InvoiceDiscountType {
  PERCENT
  FIXED
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(20)
  firstName    String   @map("first_name") @db.VarChar(150)
  lastName     String   @map("last_name") @db.VarChar(150)
  dob          DateTime @db.Date
  mobileNo     String   @map("mobile_no") @db.VarChar(20)
  email        String?  @unique @db.VarChar(255)
  role         UserRole
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  assignedEnquiries Enquiry[]    @relation("EnquiryAssignedTo")
  followUps         FollowUp[]
  payments          Payment[]
  invoices          Invoice[]
  inventoryOrders   InventoryOrder[]

  @@map("users")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById BigInt?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("TokenRotation")

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model Customer {
  id                BigInt   @id @default(autoincrement())
  firstName         String   @map("first_name") @db.VarChar(150)
  lastName          String   @map("last_name") @db.VarChar(150)
  mobileNo          String   @map("mobile_no") @db.VarChar(20)
  alternateMobileNo String?  @map("alternate_mobile_no") @db.VarChar(20)
  emailId           String?  @map("email_id") @db.VarChar(255)
  address           String?
  city              String?  @db.VarChar(100)
  state             String?  @db.VarChar(100)
  pincode           String?  @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  enquiries Enquiry[]
  events    Event[]

  @@index([mobileNo], map: "idx_customer_mobile")
  @@map("customers")
}

model Enquiry {
  id          BigInt     @id @default(autoincrement())
  customerId  BigInt     @map("customer_id")
  enquiryDate DateTime   @default(now()) @map("enquiry_date") @db.Date
  leadSource  String?    @map("lead_source") @db.VarChar(100)
  status      LeadStatus @default(NEW)
  assignedTo  BigInt?    @map("assigned_to")
  remarks     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser User?    @relation("EnquiryAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  event      Event?
  followUps  FollowUp[]

  @@index([status], map: "idx_enquiry_status")
  @@map("enquiries")
}

model Event {
  id                   BigInt      @id @default(autoincrement())
  enquiryId            BigInt      @unique @map("enquiry_id")
  customerId           BigInt      @map("customer_id")
  eventType            String      @map("event_type") @db.VarChar(100)
  eventDate            DateTime    @map("event_date") @db.Date
  timeSlot             TimeSlot?   @map("time_slot")
  guestCount           Int?        @map("guest_count")
  venue                String?     @db.VarChar(255)
  menuPackage          String?     @map("menu_package") @db.VarChar(255)
  platePackageId       String?     @map("plate_package_id") @db.VarChar(50)
  menuItemIds          String[]    @default([]) @map("menu_item_ids")
  menuSavedAt          DateTime?   @map("menu_saved_at")
  approxBudget         Decimal?    @map("approx_budget") @db.Decimal(12, 2)
  decorationRequired   Boolean     @default(false) @map("decoration_required")
  referenceBy          String?     @map("reference_by") @db.VarChar(255)
  specialRequirements  String?     @map("special_requirements")
  status               EventStatus @default(TENTATIVE)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  enquiry   Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  followUps FollowUp[]
  booking   Booking?
  inventoryOrders InventoryOrder[]

  @@index([eventDate], map: "idx_event_date")
  @@index([status], map: "idx_event_status")
  @@map("events")
}

model FollowUp {
  id               BigInt             @id @default(autoincrement())
  enquiryId        BigInt             @map("enquiry_id")
  eventId          BigInt?            @map("event_id")
  followupDate     DateTime           @default(now()) @map("followup_date")
  nextFollowupDate DateTime?          @map("next_followup_date")
  communicationType CommunicationType? @map("communication_type")
  comments         String?
  followedBy       BigInt?            @map("followed_by")
  createdAt        DateTime           @default(now()) @map("created_at")

  enquiry      Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  event        Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  followedByUser User? @relation(fields: [followedBy], references: [id], onDelete: SetNull)

  @@index([nextFollowupDate], map: "idx_followup_next_date")
  @@map("follow_ups")
}

model Booking {
  id            BigInt        @id @default(autoincrement())
  eventId       BigInt        @unique @map("event_id")
  bookingNumber String?       @unique @map("booking_number") @db.VarChar(50)
  bookingDate   DateTime      @default(now()) @map("booking_date") @db.Date
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  advanceAmount Decimal       @default(0) @map("advance_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount   Decimal       @default(0) @map("final_amount") @db.Decimal(12, 2)
  status        BookingStatus @default(CONFIRMED)
  comments      String?
  createdAt     DateTime      @default(now()) @map("created_at")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments Payment[]
  invoices Invoice[]

  @@index([status], map: "idx_booking_status")
  @@map("bookings")
}

model VendorCategory {
  id           BigInt   @id @default(autoincrement())
  categoryName String   @unique @map("category_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  vendors Vendor[]

  @@map("vendor_categories")
}

model Vendor {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt?  @map("category_id")
  vendorName String   @map("vendor_name") @db.VarChar(255)
  mobile     String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  address    String?
  gstNumber  String?  @map("gst_number") @db.VarChar(50)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  category  VendorCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments  Payment[]
  inventory Inventory[]
  inventoryOrders InventoryOrder[]

  @@map("vendors")
}

model Payment {
  id              BigInt       @id @default(autoincrement())
  bookingId       BigInt?      @map("booking_id")
  vendorId        BigInt?      @map("vendor_id")
  paymentType     PaymentType  @map("payment_type")
  transactionType String?      @map("transaction_type") @db.VarChar(100)
  transactionDate DateTime     @default(now()) @map("transaction_date")
  paymentMode     PaymentMode? @map("payment_mode")
  amount          Decimal      @db.Decimal(12, 2)
  description     String?
  receivedFrom    String?      @map("received_from") @db.VarChar(255)
  paidTo          String?      @map("paid_to") @db.VarChar(255)
  createdBy       BigInt?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")

  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdByUser User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([transactionDate], map: "idx_payment_date")
  @@map("payments")
}

model Inventory {
  id            BigInt          @id @default(autoincrement())
  vendorId      BigInt?         @map("vendor_id")
  title         String          @db.VarChar(255)
  description   String?
  category      String?         @db.VarChar(100)
  quantity      Decimal?        @db.Decimal(10, 2)
  unit          String?         @db.VarChar(50)
  purchasePrice Decimal?        @map("purchase_price") @db.Decimal(12, 2)
  purchaseDate  DateTime?       @map("purchase_date") @db.Date
  deliveryDate  DateTime?       @map("delivery_date") @db.Date
  inventoryType InventoryType   @default(OWNED) @map("inventory_type")
  status        InventoryStatus @default(AVAILABLE)
  createdAt     DateTime        @default(now()) @map("created_at")

  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactions InventoryTransaction[]

  @@map("inventory")
}

model InventoryTransaction {
  id              BigInt                   @id @default(autoincrement())
  inventoryId     BigInt                   @map("inventory_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Decimal?                 @db.Decimal(10, 2)
  unitPrice       Decimal?                 @map("unit_price") @db.Decimal(12, 2)
  totalAmount     Decimal?                 @map("total_amount") @db.Decimal(12, 2)
  transactionDate DateTime                 @default(now()) @map("transaction_date")
  remarks         String?

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_transactions")
}

model Invoice {
  id                  BigInt              @id @default(autoincrement())
  invoiceNumber       String              @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate         DateTime            @map("invoice_date") @db.Date
  dueDate             DateTime?           @map("due_date") @db.Date
  businessName        String              @map("business_name") @db.VarChar(120)
  businessAddress     String?             @map("business_address")
  businessPhone       String?             @map("business_phone") @db.VarChar(20)
  businessEmail       String?             @map("business_email") @db.VarChar(255)
  authorizedSignatory String?             @map("authorized_signatory") @db.VarChar(80)
  paymentInfo         String?             @map("payment_info")
  customerName        String              @map("customer_name") @db.VarChar(100)
  customerAddress     String?             @map("customer_address")
  customerPhone       String?             @map("customer_phone") @db.VarChar(20)
  customerEmail       String?             @map("customer_email") @db.VarChar(255)
  discountType        InvoiceDiscountType @default(PERCENT) @map("discount_type")
  discountPercent     Decimal             @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  subtotal            Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes               String?
  bookingId           BigInt?             @map("booking_id")
  createdBy           BigInt?             @map("created_by")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByUser User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]

  @@index([invoiceDate], map: "idx_invoice_date")
  @@map("invoices")
}

model InvoiceLineItem {
  id          BigInt  @id @default(autoincrement())
  invoiceId   BigInt  @map("invoice_id")
  description String  @db.VarChar(200)
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_line_invoice")
  @@map("invoice_line_items")
}

model InventoryOrder {
  id          BigInt               @id @default(autoincrement())
  orderNumber String               @unique @map("order_number") @db.VarChar(50)
  vendorId    BigInt               @map("vendor_id")
  eventId     BigInt?              @map("event_id")
  deliveryAt  DateTime             @map("delivery_at")
  notes       String?
  status      InventoryOrderStatus @default(PLACED)
  createdBy   BigInt?              @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at")

  vendor        Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  event         Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdByUser User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  lineItems     InventoryOrderLine[]

  @@index([vendorId], map: "idx_inventory_order_vendor")
  @@index([deliveryAt], map: "idx_inventory_order_delivery")
  @@map("inventory_orders")
}

model InventoryOrderLine {
  id               BigInt  @id @default(autoincrement())
  orderId          BigInt  @map("order_id")
  materialId       String  @map("material_id") @db.VarChar(120)
  materialName     String  @map("material_name") @db.VarChar(255)
  materialCategory String? @map("material_category") @db.VarChar(100)
  unit             String  @db.VarChar(50)
  quantity         Decimal @db.Decimal(10, 2)
  sortOrder        Int     @default(0) @map("sort_order")

  order InventoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_inventory_order_line_order")
  @@map("inventory_order_lines")
}

model DirectoryContact {
  id        BigInt               @id @default(autoincrement())
  type      DirectoryContactType
  name      String               @db.VarChar(255)
  mobile    String?              @db.VarChar(20)
  email     String?              @db.VarChar(255)
  address   String?
  notes     String?
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([type], map: "idx_directory_contact_type")
  @@map("directory_contacts")
}
